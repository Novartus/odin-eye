# Expo & React Native Production .gitignore
# Reference: https://docs.expo.dev/guides/customizing-metro/#custom-metro-config

# Dependencies
node_modules/
/.pnp
.pnp.js

# Expo
.expo/
dist/
web-build/

# Native Builds (Expo Prebuild / Bare React Native)
# EAS Build regenerates these via Prebuild (CNG) — do not commit
# /android/
/ios/

# Metro & Bundler
.metro-health-check*
*.js.meta

# Environment variables & API credentials (Security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem

# Keystore, Certificates & Mobile Provisions (Security)
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
*.stackdump

# Testing & Code Coverage
coverage/
.nyc_output/
reports/
*.lcov

# TypeScript
*.tsbuildinfo

# IDE & Editor Configs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.project
.classpath
.settings/
*.iml

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary & Build Dumps
tmp/
temp/
scratch/